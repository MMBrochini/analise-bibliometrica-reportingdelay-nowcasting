# 3. FUNÇÃO PARA EXTRAIR TERMOS DO RESUMO (AB)
# ============================================
get_terms_from_abstracts <- function(df, periodo_nome, stopwords, n_terms = 30) {
# Filtrar por período
subset_df <- df[df$periodo == periodo_nome, ]
if(nrow(subset_df) == 0) {
cat("⚠️ Nenhum dado para o período:", periodo_nome, "\n")
return(NULL)
}
# Verificar se o campo AB existe
if(!"AB" %in% names(subset_df)) {
cat("⚠️ Campo 'AB' (Abstract) não encontrado!\n")
return(NULL)
}
# Juntar todos os resumos
abstracts <- subset_df$AB[!is.na(subset_df$AB) & subset_df$AB != ""]
if(length(abstracts) == 0) {
cat("⚠️ Nenhum resumo encontrado para o período:", periodo_nome, "\n")
return(NULL)
}
# Processamento de texto
textos <- paste(abstracts, collapse = " ")
textos <- tolower(textos)
textos <- gsub("[[:punct:]]", " ", textos)
textos <- gsub("[0-9]", " ", textos)
textos <- gsub("\\s+", " ", textos)
# Separar palavras
palavras <- unlist(strsplit(textos, " "))
palavras <- palavras[nchar(palavras) >= 4]
palavras <- palavras[!palavras %in% stopwords]
palavras <- palavras[palavras != ""]
# Calcular frequência
freq <- sort(table(palavras), decreasing = TRUE)
# Selecionar top n_terms
freq <- head(freq, n_terms)
return(data.frame(
Periodo = periodo_nome,
Termo = names(freq),
Frequencia = as.numeric(freq),
stringsAsFactors = FALSE
))
}
cat("✅ Função get_terms_from_abstracts definida\n")
