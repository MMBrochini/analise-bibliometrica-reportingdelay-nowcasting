# 5. AGRUPAR SINÔNIMOS (delay/delays, case/cases)
# ============================================
agrupar_sinonimos <- function(df) {
if(is.null(df)) return(NULL)
# Substituir "delays" por "delay"
df$Termo[df$Termo == "delays"] <- "delay"
# Substituir "cases" por "case"
df$Termo[df$Termo == "cases"] <- "case"
# Agrupar e somar frequências
resultado <- aggregate(Frequencia ~ Periodo + Termo, data = df, FUN = sum)
return(resultado)
}
metodos_classicos_1982_1995 <- agrupar_sinonimos(metodos_classicos_1982_1995)
integracao_vigilancia_1996_2005 <- agrupar_sinonimos(integracao_vigilancia_1996_2005)
series_temporais_2006_2015 <- agrupar_sinonimos(series_temporais_2006_2015)
nowcasting_2016_2019 <- agrupar_sinonimos(nowcasting_2016_2019)
ntegracao_metodos_2020_2026) <- agrupar_sinonimos(ntegracao_metodos_2020_2026))
